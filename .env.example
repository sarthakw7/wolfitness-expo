## wolfitness-expo environment
##
## Copy to `.env` and fill in values.
## IMPORTANT: `.env` must never be committed.

# Supabase (public client config)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Signal CMS/backend base URL for mobile program browsing.
# Local development on a physical device: do NOT use localhost. Use your Mac LAN IP.
# Example: http://192.168.1.16:3000
EXPO_PUBLIC_SIGNAL_API_URL=

# Wolfitness web/backend base URL for mobile AI nutrition, purchases, and Wolf AI.
# Local development on a physical device: do NOT use localhost. Use your Mac LAN IP.
# Example: http://192.168.1.16:3001
EXPO_PUBLIC_WOLFITNESS_API_URL=

# Sentry crash reporting (public DSN is safe to expose to the client)
# Runtime/client capture only. This is enough to send events from the app.
EXPO_PUBLIC_SENTRY_DSN=

# Optional app environment label sent to Sentry, e.g. development / preview / production
EXPO_PUBLIC_APP_ENV=

# Optional local-only debugging switches for Expo development builds
EXPO_PUBLIC_SENTRY_ENABLE_DEV=false
EXPO_PUBLIC_SENTRY_DEBUG=false

# Sentry source map upload (EAS/CI only; do NOT put these in the client .env file)
# Required for readable production stack traces / symbolicated errors.
# Store these in EAS secrets or your CI secret manager instead of committing them.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Settings / account surface
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
